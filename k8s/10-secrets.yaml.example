# Console secrets — copy and fill in real values before applying.
#
#   cp k8s/console/10-secrets.yaml.example k8s/console/10-secrets.yaml
#   # edit 10-secrets.yaml — replace every <...> placeholder
#   kubectl apply -f k8s/console/10-secrets.yaml
#
# 10-secrets.yaml is gitignored. Never commit the filled-in file.
---
# console-auth — next-auth session secret + operator password.
# CONSOLE_PASSWORD     : plain-text password the operator enters at login.
#                        Rotated via the /settings page (patches this Secret
#                        via the K8s API and reloads the session middleware).
# NEXTAUTH_SECRET      : random 32-byte base64 string for JWT signing.
#                        Generate with: openssl rand -base64 32
apiVersion: v1
kind: Secret
metadata:
  name: console-auth
  namespace: console
type: Opaque
stringData:
  CONSOLE_PASSWORD: "<change-me>"
  NEXTAUTH_SECRET: "<openssl rand -base64 32>"

---
# console-aws — AWS credentials for Security Group whitelist CRUD.
# The console uses these to call DescribeSecurityGroups,
# AuthorizeSecurityGroupIngress, and RevokeSecurityGroupIngress
# from the /settings → Network access panel.
#
# Minimum IAM policy:
#   ec2:DescribeSecurityGroups
#   ec2:AuthorizeSecurityGroupIngress
#   ec2:RevokeSecurityGroupIngress
#
# Rotate via /secrets page (patches this Secret + logs the rotation timestamp).
# A nag banner appears in /settings when credentials are > 90 days old.
apiVersion: v1
kind: Secret
metadata:
  name: console-aws
  namespace: console
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "<AKIA...>"
  AWS_SECRET_ACCESS_KEY: "<secret>"
  # AWS_SESSION_TOKEN is optional — omit for long-lived IAM user keys.
  AWS_SESSION_TOKEN: ""
  # ID of the EC2 Security Group that controls :8800 inbound access.
  # Find it with: aws ec2 describe-instances --instance-ids <id> --query
  #   'Reservations[0].Instances[0].SecurityGroups[0].GroupId'
  VSS_INSTANCE_SG_ID: "sg-<id>"
  # Region where the VSS EC2 instance lives. Defaults to us-west-2.
  AWS_REGION: "us-west-2"

---
# console-ssh — camera-sim SSH private key.
# Raw PEM of the ed25519 key authorized on the camera-sim EC2 instance.
# Mounted read-only at /etc/camera-sim/id_ed25519 inside the console pod.
#
# IMPORTANT: the PEM must include a trailing newline after the last line
# (-----END OPENSSH PRIVATE KEY-----\n). ssh2 / OpenSSH reject keys
# without it. Rotate via /secrets page; a nag banner appears after 90 days.
apiVersion: v1
kind: Secret
metadata:
  name: console-ssh
  namespace: console
type: Opaque
stringData:
  id_ed25519: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    <base64-encoded-key-body>
    -----END OPENSSH PRIVATE KEY-----
