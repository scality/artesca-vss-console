# Console auth — single shared password injected from K8s Secret console-auth
# Set CONSOLE_PASSWORD_HASH (bcrypt) for production; CONSOLE_PASSWORD for dev.
CONSOLE_PASSWORD=changeme

# bcrypt hash of CONSOLE_PASSWORD (optional; takes precedence over plain-text)
# Generate: node -e "const b=require('bcryptjs');b.hash('yourpass',12).then(console.log)"
# CONSOLE_PASSWORD_HASH=

# Auth.js cookie-signing secret — generate with: openssl rand -base64 32
# Required whenever NODE_ENV=production (`npm start`, the container, the
# in-cluster pod). Auth.js reads AUTH_SECRET; the NEXTAUTH_-prefixed spelling is
# not consulted, so a deploy that sets only that one refuses every request while
# `src/instrumentation.ts` logs `missing env vars: AUTH_SECRET` at startup.
AUTH_SECRET=replace-with-random-secret

# Public URL of the console, for Auth.js callbacks.
# Local dev (`npm run dev`) binds :5003 per the scality dev-server port convention.
# Production (`npm start`, container, in-cluster pod) binds :8800 — swap the URL
# before copying this file into a prod deploy.
AUTH_URL=http://localhost:5003

# Skip the sign-in gate entirely — every request is treated as authenticated.
# Only for a local run or an automated suite: `src/proxy.ts` stops guarding any
# page while it is on. The E2E specs need it, because they stub
# /api/auth/session with `page.route`, which the middleware never sees.
# CONSOLE_DISABLE_AUTH=true

# ── Helm layout (default) ────────────────────────────────────────────────────
# VSS_NAMESPACE: Helm release namespace for all VSS components.
# Format: vss-<profile>  (e.g. vss-base, vss-alerts).
# deploy-console.sh renders this from SCALITY_BP_PROFILE (default: base).
VSS_NAMESPACE=vss-base

# CONSOLE_LEGACY_NAMESPACES: set to "1" to activate the pre-Helm per-component
# namespace layout (vst / rtvi / agent / alerts). Unset or "0" = Helm (default).
# CONSOLE_LEGACY_NAMESPACES=0

# ── Which runtime the console drives (unset = Kubernetes) ─────────────────────
# CONSOLE_RUNTIME=docker switches the console from talking to the Kubernetes API
# to talking to a local Docker daemon over /var/run/docker.sock: containers are
# inspected and recreated with dockerRecreateWithEnv instead of Deployments being
# patched and rolled, and /cameras, /prompt and /scenarios take the GCS/ConfigMap
# path rather than the config store's write-through reconcile.
#
# It is not a small flag. Thirty modules under src/ branch on it, so a change to a
# route that touches cameras, prompt, scenarios, restart, logs, gpu, pods or
# diagnostics usually has to work both ways — 22 test files cover the pair. Leave
# it unset for in-cluster work; set it only when running against compose with the
# socket mounted, which requires the container to have it bind-mounted.
# CONSOLE_RUNTIME=docker

# Comma-separated list of K8s namespaces to observe.
# Helm default (auto-derived from VSS_NAMESPACE when unset):
#   vss-base,demo-data,pyramid-ingress
# Legacy override: vst,rtvi,agent,alerts,demo-data,pyramid-ingress
# KUBE_NAMESPACES=vss-base,demo-data,pyramid-ingress

# Kafka broker(s) — Confluent kafka-kafka StatefulSet in vss-<profile>.
# Verified on live cluster: kafka-kafka.<vss-ns>.svc.cluster.local:9092
# Auto-derived from VSS_NAMESPACE when unset.
# KAFKA_BROKERS=kafka-kafka.vss-base.svc.cluster.local:9092

# Redis URL — redis StatefulSet in vss-<profile>.
# Auto-derived from VSS_NAMESPACE when unset.
# REDIS_URL=redis://redis.vss-base.svc.cluster.local:6379

# Camera-sim EC2 instance
CAMERA_SIM_HOST=
CAMERA_SIM_SSH_USER=ubuntu
CAMERA_SIM_SSH_KEY_PATH=/run/secrets/camera-sim-ssh-key

# ARTESCA S3 / AWS credentials (for nvidia-vss-video bucket stats + SG whitelist)
S3_ENDPOINT=
S3_BUCKET=nvidia-vss-video
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # optional; set when using STS/SSO credentials

# EC2 Security Group ID for port 5003 whitelist management
VSS_INSTANCE_SG_ID=

# NIM preview endpoint (nvila-lite-preview in vss-<profile>).
# Auto-derived from VSS_NAMESPACE when unset.
# NIM_PREVIEW_ENDPOINT=http://nvila-lite-preview.vss-base.svc.cluster.local:8000

# SQLite data directory — backed by the console-data PVC in production
CONSOLE_DATA_DIR=/data
